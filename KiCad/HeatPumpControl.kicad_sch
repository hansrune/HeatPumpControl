	)
	(text "NOTES:\n  D7, D9, D10 normally 0 ohm\n  R10 and R12 normally unused\n\nERRORS:\n  H2 / IR receiver has no GND\n  Q1 is upside down \n   "
		(exclude_from_sim no)
		(at 212.09 124.46 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left bottom)
		)
		(uuid "d4cb8b82-c7ad-4d3f-8c1c-421fb11e14e5")
	)
	(text "D0  - PULLED UP - N/A\nA1  - General IO, no pull-uo\nD2  - IR out\nD3  - PIR, 1-Wire,\n           open drain/collector,\n           any pulled up\nD4  - I2C SDA\nD5  - I2C SCL\nD8  - PULLED UP - N/A\nD9  - ILED\nD10 - PIR, 1-Wire, \n           open drain/collector,\n           any pulled up\nD6  - RX <--> TX\nD7  - TX <--> RX"
		(exclude_from_sim no)
		(at 212.09 85.09 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left bottom)
		)
